# ──────────────────────────────────────────────────────────────
# Kejetia auth gateway — environment variables
# Copy to `.env` and fill in. Never commit the real .env.
# ──────────────────────────────────────────────────────────────

# Server
PORT=5000
# Comma-separated list of allowed browser origins for CORS
ALLOWED_ORIGINS=http://localhost:3000
# Public app URL used in verification success emails (sign-in link)
APP_URL=http://localhost:3000

# Supabase (service role — server only, NEVER expose to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis (OTP storage, rate limits, login lockouts)
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────────────────────
# SMTP / email (OTP verification)
# ──────────────────────────────────────────────────────────────
# Option A — a well-known service (recommended for Gmail). With Gmail you
# MUST create an "App Password" (Google Account > Security > App passwords)
# and use it as SMTP_PASS; your normal password will NOT work.
SMTP_SERVICE=gmail
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=your-address@gmail.com

# Option B — explicit host/port for any provider (leave SMTP_SERVICE unset
# if you use this). secure is auto-true for port 465, false otherwise;
# override with SMTP_SECURE=true|false.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# EMAIL_FROM=no-reply@yourdomain.com
